PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pg_hostel_db

# Fallback: If MySQL is unavailable, server automatically uses SQLite (src/database/hostel.sqlite)
# Set DB_CLIENT=sqlite to force SQLite mode directly

# JWT Authentication
JWT_SECRET=pg_hostel_secret_jwt_key_2026_super_secure_college_portal
JWT_EXPIRES_IN=7d

# Hostel Brand Info
HOSTEL_NAME=PG Hostel Management System
DEFAULT_MONTHLY_FEE=7000
TOTAL_FLOORS=5
ROOMS_PER_FLOOR=10
BEDS_PER_ROOM=5
