# ==============================================================
# SRI RAM PG - ENVIRONMENT CONFIGURATION (ONLINE PRODUCTION READY)
# ==============================================================

PORT=5000
NODE_ENV=production

# --------------------------------------------------------------
# CLOUD DATABASE OPTIONS (Choose Option A or Option B)
# --------------------------------------------------------------

# OPTION A: Full Cloud Connection String (Recommended for TiDB, Railway, Render, Aiven)
# DATABASE_URL=mysql://user:password@gateway.region.tidbcloud.com:4000/pg_hostel_db?sslmode=require

# OPTION B: Discrete Cloud MySQL Credentials
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pg_hostel_db
DB_SSL=true

# Local Fallback: Set DB_CLIENT=sqlite to use local embedded file (src/database/hostel.sqlite)
# DB_CLIENT=sqlite

# --------------------------------------------------------------
# JWT AUTHENTICATION
# --------------------------------------------------------------
JWT_SECRET=pg_hostel_secret_jwt_key_2026_super_secure_college_portal_production
JWT_EXPIRES_IN=7d

# --------------------------------------------------------------
# HOSTEL BRAND & CAPACITY CONFIGURATION
# --------------------------------------------------------------
HOSTEL_NAME=SRI RAM PG
DEFAULT_MONTHLY_FEE=7000
TOTAL_FLOORS=5
ROOMS_PER_FLOOR=10
BEDS_PER_ROOM=5
